<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="mdx_settings_title">人聲分離</string>
    <string name="mdx_settings_intro">K 歌使用 MDX-Net（UVR 9703）在裝置上分離人聲，產生伴奏。內建模型版可直接使用，標準版只需下載一次模型。</string>
    <string name="mdx_settings_checking">正在檢查模型…</string>
    <string name="mdx_settings_installed">MDX-Net 模型已安裝</string>
    <string name="mdx_settings_missing">尚未下載模型。下載後即可在 K 歌中使用。</string>
    <string name="mdx_settings_enabled">在 K 歌使用分離模型</string>
    <string name="mdx_settings_enabled_hint">開啟後通常能去除更多原唱，首次分離需要更多時間和記憶體。關閉模型或記憶體不足時會使用較快的基本處理，可能保留更多人聲。</string>
    <string name="mdx_settings_parameters">分離參數</string>
    <string name="mdx_settings_strength">人聲消除強度</string>
    <string name="mdx_settings_strength_hint">預設 103%。提高強度會從原音中扣除更多預測人聲，過高可能削弱樂器或產生失真。降低強度可保留更多伴奏細節，也可能留下更多原唱。</string>
    <string name="mdx_settings_overlap">分塊重疊</string>
    <string name="mdx_settings_overlap_hint">預設 250 毫秒。增加相鄰音訊區塊的重疊可讓接縫更平滑，但會增加推論次數和處理時間。</string>
    <string name="mdx_settings_threads">推論執行緒數</string>
    <string name="mdx_settings_threads_hint">預設使用裝置可用的 CPU 核心數。更多執行緒可能加快分離，也可能增加發熱和耗電。實際速度取決於裝置。</string>
    <string name="mdx_value_threads_auto">依核心數（%1$d）</string>
    <string name="mdx_settings_apply_hint">設定會在下次準備伴奏時生效。只有消除強度和分塊重疊相同時，才會重複使用分離後的伴奏快取。</string>
    <string name="mdx_value_millis">%1$d 毫秒</string>
</resources>
